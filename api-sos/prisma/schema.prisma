// ============================================================
// API-SOS - SCHEMA DO BANCO DE DADOS
// ============================================================
// Este arquivo define as tabelas, campos, relacionamentos, índices,
// chaves únicas e o enum de status usados pelo Prisma.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Estados permitidos para o ciclo de vida de um chamado.
enum StatusChamado {
  ABERTO
  ACEITO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
}

// Representa os clientes que abrem chamados.
model Cliente {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String
  email        String    @unique
  senhaHash    String
  telefone     String?
  cpf          String    @unique
  dataCadastro DateTime  @default(now())
  chamados     Chamado[]
}

// Representa os profissionais que atendem chamados.
model Prestador {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String
  email        String    @unique
  senhaHash    String
  telefone     String?
  cpf          String    @unique
  categoriaId  Int
  disponivel   Boolean   @default(true)
  latitude     Decimal?  @db.Decimal(10,7)
  longitude    Decimal?  @db.Decimal(10,7)
  dataCadastro DateTime  @default(now())
  categoria    Categoria @relation(fields:[categoriaId], references:[id])
  chamados     Chamado[]
  @@index([categoriaId, disponivel])
}

// Categorias de serviços disponíveis.
model Categoria {
  id          Int         @id @default(autoincrement())
  nome        String      @unique
  prestadores Prestador[]
  chamados    Chamado[]
}

// Solicitação de assistência feita por um cliente.
model Chamado {
  id            String        @id @default(uuid()) @db.Uuid
  clienteId     String        @db.Uuid
  categoriaId   Int
  prestadorId   String?       @db.Uuid
  latitude      Decimal       @db.Decimal(10,7)
  longitude     Decimal       @db.Decimal(10,7)
  endereco      String?
  descricao     String?
  status        StatusChamado @default(ABERTO)
  dataAbertura  DateTime      @default(now())
  dataAceite    DateTime?
  dataConclusao DateTime?
  cliente       Cliente       @relation(fields:[clienteId], references:[id], onDelete:Restrict)
  categoria     Categoria     @relation(fields:[categoriaId], references:[id], onDelete:Restrict)
  prestador     Prestador?    @relation(fields:[prestadorId], references:[id], onDelete:Restrict)
  avaliacao     Avaliacao?
  @@index([clienteId])
  @@index([categoriaId, status])
  @@index([prestadorId, status])
}

// Avaliação feita pelo cliente após a conclusão do chamado.
model Avaliacao {
  id            String   @id @default(uuid()) @db.Uuid
  chamadoId     String   @unique @db.Uuid
  nota          Int
  comentario    String?
  dataAvaliacao DateTime @default(now())
  chamado       Chamado  @relation(fields:[chamadoId], references:[id], onDelete:Restrict)
}